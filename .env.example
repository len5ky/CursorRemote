# === Core ===
CDP_URL=http://127.0.0.1:9222
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
POLL_INTERVAL_MS=500
DEBOUNCE_MS=300
SELECTORS_PATH=./selectors.json
LOG_LEVEL=info

# === Window Titles ===
# Include remote qualifier ([WSL: ...], [SSH: ...]) in window titles.
# Set to false for cleaner Telegram topic names when you don't need to
# distinguish the same project opened locally and remotely.
# WINDOW_TITLE_QUALIFIER=false

# === Web App Security (optional) ===
# Set a password to protect the web UI. Supply it from a secret store; do not
# put the real value in this file.
# MANDATORY when VOICE_ENABLED=true — the private voice surface refuses to
# start (and refuses to serve) without it. Never commit the real value.
WEBAPP_PASSWORD=

# === Private voice PWA (optional) ===
# Full operator guide: docs/private-voice-pwa-deploy.md
# Names only below. Never commit real secrets to this file.

# Enable the private read-only voice transport. Requires WEBAPP_PASSWORD.
VOICE_ENABLED=false

# Server-only OpenAI standard key. Mints ephemeral browser credentials and
# opens the sideband WebSocket. Never sent to the browser, never logged,
# never persisted. Leave blank here; supply it from your secret store.
OPENAI_API_KEY=

# Canonical public origin of the voice PWA, exactly as the browser sends it.
# REQUIRED for any non-loopback deployment: with it unset, only
# http://127.0.0.1:<SERVER_PORT>, http://localhost:<SERVER_PORT> and
# http://[::1]:<SERVER_PORT> are accepted and every phone request is refused
# with 403 "Origin denied". It is never inferred from Host or X-Forwarded-*.
# Scheme + host (+ port) only: no path, query, fragment or credentials.
# VOICE_PUBLIC_ORIGIN=https://<machine>.<tailnet>.ts.net

# Read-only Hermes context endpoint. HTTPS, or HTTP on loopback only.
# If unset, voice reports context unavailable — it never invents content.
# HERMES_READ_CONTEXT_URL=
# Optional server-only bearer for that endpoint. Never returned or logged.
# HERMES_READ_CONTEXT_TOKEN=

# There is NO configurable model. Every Realtime session is pinned to
# gpt-realtime-2.1 — no mini, no preview, no fallback. VOICE_MODEL exists only
# as a tripwire: set it to anything else and the server refuses to start.
# VOICE_MODEL=gpt-realtime-2.1

# Realtime output voice.
# VOICE_NAME=marin

# Stable single-operator budget account. The daily cost cap is keyed to this,
# NOT to a login session — otherwise logging out and back in would hand you a
# fresh daily cap. It is not a secret, but it is never returned in a response,
# never logged, and only ever stored hashed. 1-64 chars from [A-Za-z0-9._@-].
# VOICE_ACCOUNT_ID=default-operator

# Cost caps. Admission is denied unless the price version is one this build
# knows: see VOICE_PRICE_TABLE in src/server/transports/voice/pricing.ts. An
# invented version is a startup failure, not a silently accepted rate card.
# The unit price defaults to the table's reference rate for that version; raise
# it to be more conservative. Per-session cap must not exceed the daily cap.
# VOICE_USAGE_PRICE_VERSION=openai-realtime-2026-01
# VOICE_USAGE_UNIT_PRICE_CENTS_PER_MINUTE=50
# VOICE_USAGE_DAILY_CAP_CENTS=500
# VOICE_USAGE_PER_SESSION_CAP_CENTS=100

# Session lifecycle bounds (milliseconds). Every numeric value here is validated
# at startup: a non-integer or out-of-range value fails the boot rather than
# silently becoming NaN and disabling the bound it was meant to enforce.
# VOICE_SESSION_ABSOLUTE_MS=1800000
# VOICE_SESSION_IDLE_MS=120000
# VOICE_SESSION_IDLE_GRACE_MS=60000
# VOICE_SESSION_LEASE_MS=30000

# === Tailscale Serve identity (optional) ===
# Set true ONLY when this relay is published exclusively through
# `tailscale serve` to loopback. It lets the login rate limiter bucket per
# verified Tailscale user instead of collapsing the whole tailnet into one
# loopback bucket. Serve's Tailscale-User-* headers are read only when this is
# true AND the request arrives from loopback; a global login guard applies
# either way. Leave unset on any other topology.
# TAILSCALE_SERVE_IDENTITY=false

# === Telegram Transport (optional) ===
TELEGRAM_ENABLED=false
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram implementation: "grammy" (default) or "raw".
# Use "raw" if the Grammy bot hangs during startup on your machine
# (typically macOS with network issues to api.telegram.org).
# The raw transport uses Node's built-in fetch with explicit timeouts.
# TELEGRAM_IMPL=grammy

# Optional: hardcode allowed user IDs (overrides /register token auth)
# If set, only these users can use the bot. If not set, anyone with the
# registration token (shown in server console) can /register themselves.
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# === Extension Integration (optional) ===
# These are set automatically when running as a VS Code extension child process.
# You normally don't need to set them for standalone usage.
# LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-XXXX
# DATA_DIR=./data
# LOG_FORMAT=text

# DATA_DIR also holds the voice cost/session ledger (voice-usage.json, mode
# 0600). No audio, transcript, SDP, provider event body or credential is ever
# written there.
